PORT=3000
VERIFY_TOKEN=maajaanki_verify
WHATSAPP_TOKEN=YOUR_META_TOKEN
PHONE_NUMBER_ID=YOUR_PHONE_NUMBER_ID
SUPABASE_URL=YOUR_SUPABASE_URL
# Use the service role key on the server so inserts/selects work with RLS.
# Also required for npm run wipe:orders (bulk deletes); otherwise use scripts/wipe_all_orders.sql in SQL Editor.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
# Legacy alias (anon or service key):
SUPABASE_KEY=YOUR_SUPABASE_KEY

# UPI + QR (option 2 in WhatsApp checkout)
RESTAURANT_UPI_ID=2940446326210324@hdfcbank
RESTAURANT_UPI_PAYEE_NAME=Maa Jaanki Restaurant
# Public URL of this backend so WhatsApp can load QR (recommended on Render/Railway)
APP_PUBLIC_URL=https://your-backend.onrender.com
# Or direct QR image URL (optional override)
# RESTAURANT_UPI_QR_URL=https://example.com/assets/payment-qr.png
# Local QR file path (default: assets/payment-qr.png)
# RESTAURANT_UPI_QR_PATH=

# Dashboard: verify UPI orders at /admin.html
ADMIN_VERIFY_KEY=change-this-secret-key
